  questsToGive:
  - {fileID: 11400000, guid: db3cfeff532ca864d9bc2cfd381deea6, type: 2}
  destroyAfterTalk: 0
  defaultLines:
  - Greetings, traveler.
  questIntroLines:
  - Could you help me complete this request?
  dialogueGroups:
  - groupID: MAIN
    options:
    - buttonText: Can't you go there yourself?
      type: 0
      npcResponse:
      - My arms and legs are shaking like this, how could I possibly walk, young
        man?
      nextGroupID: LORE
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
    - buttonText: Hand over all the money you have, don't make me angry.
      type: 0
      npcResponse:
      - :(
      - '"Don''t threaten me, young man. Just help me out and I will reward you handsomely.'
      nextGroupID: LORE
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
  - groupID: LORE
    options:
    - buttonText: Sigh, fine, let me help you then.
      type: 0
      npcResponse:
      - Thanks you !
      nextGroupID: 
      returnToMain: 0
      closeDialogue: 1
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
