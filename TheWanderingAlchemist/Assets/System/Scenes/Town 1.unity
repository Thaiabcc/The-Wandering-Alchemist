  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f18211b96281ffa4eb4cb4385acdf884, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Traveller
  questsToGive:
  - {fileID: 11400000, guid: 7328cf7b2a113ac4799c733de2466224, type: 2}
  destroyAfterTalk: 0
  defaultLines:
  - Hi there....
  questIntroLines:
  - You look so good
  dialogueGroups:
  - groupID: MAIN
    options:
    - buttonText: Why the scowl, buddy? What's wrong?
      type: 0
      npcResponse:
      - Fought a robber yesterday, now everything hurts.
      - I am in great need of a healing potion, brother.
      nextGroupID: OK
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
    - buttonText: Verily, my pockets are as empty as my health bar. Mind sparing
        some gold, brother?
      type: 0
      npcResponse:
      - How much are we talking about? Name your price, my friend.
      nextGroupID: NEXT
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
  - groupID: NEXT
    options:
    - buttonText: Perchance... half of your house, buddy?
      type: 0
      npcResponse:
      - ???????
      - Is this a joke to you?
      nextGroupID: 
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
  - groupID: OK
    options:
    - buttonText: Fine by me. Just sit tight for a bit, okay?
      type: 0
      npcResponse:
      - Thank you !
      nextGroupID: 
      returnToMain: 0
      closeDialogue: 0
      isOneTimeOnly: 0
      onOptionSelected:
        m_PersistentCalls:
          m_Calls: []
      hasBeenClicked: 0
