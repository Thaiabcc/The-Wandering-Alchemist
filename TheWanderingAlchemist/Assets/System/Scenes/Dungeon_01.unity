  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "One is born with the <color=#FFD700>golden sunshine</color>, symbolizing
    beginnings and hope.\r\nOne carries the breath of the <color=#0077BE>deep blue
    ocean</color>, profound and serene.\r\nOne swallows the light whole, a <color=#111111>pitch-black
    void</color> where all things end.\r\nAnd the last one flows within the veins\u2014a
    <color=#8B0000>crimson tide</color> of both life and destruction."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 055afa002b2584f4d9fcead22b069d1c, type: 2}
  m_sharedMaterial: {fileID: 5164779088626915098, guid: 055afa002b2584f4d9fcead22b069d1c, type: 2}
